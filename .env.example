# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_pegawai?schema=public"

# JWT
JWT_SECRET="ganti_dengan_secret_key_yang_kuat"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="ganti_dengan_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"

# App
APP_NAME="Sistem Pengelolaan Data Pegawai"
APP_PORT=3000
NODE_ENV="development"

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR="public/uploads"

# Rate Limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
