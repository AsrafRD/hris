{
  "openapi": "3.0.0",
  "info": {
    "title": "API Sistem Pengelolaan Data Pegawai",
    "version": "1.0.0",
    "description": "Dokumentasi API untuk sistem SDM Digital"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Server Lokal"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Login ke sistem",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "identitas": { "type": "string" },
                  "kata_sandi": { "type": "string" },
                  "captcha": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login berhasil" }
        }
      }
    },
    "/pegawai": {
      "get": {
        "summary": "Daftar pegawai",
        "tags": ["Pegawai"],
        "parameters": [
          { "name": "cari", "in": "query", "schema": { "type": "string" } },
          { "name": "halaman", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Berhasil" } }
      },
      "post": {
        "summary": "Tambah pegawai baru",
        "tags": ["Pegawai"],
        "responses": { "201": { "description": "Berhasil" } }
      }
    "/tunjangan/hitung": {
      "post": {
        "summary": "Hitung tunjangan transport pegawai",
        "tags": ["Tunjangan"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_pegawai": { "type": "integer" },
                  "bulan": { "type": "integer" },
                  "tahun": { "type": "integer" },
                  "hari_masuk": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Berhasil dihitung" } }
      }
    },
    "/log": {
      "get": {
        "summary": "Ambil log aktivitas",
        "tags": ["Log"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Berhasil" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
